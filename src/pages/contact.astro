---
import Layout from '../components/layout/Layout.astro';

const title = 'Contact Us | CaloriesIn';
const description = 'Get in touch with the CaloriesIn team. Questions, feedback, or data requests — we are here to help.';
const canonical = 'https://caloriesin.netlify.app/contact';
---

<Layout title={title} description={description} canonical={canonical}>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <h1 class="text-3xl sm:text-4xl font-bold text-gray-900 mb-8">Contact Us</h1>

    <div class="bg-gray-50 border border-gray-200 rounded-xl p-8 sm:p-10">
      <p class="text-lg text-gray-700 mb-6">
        Have a question, suggestion, or found an error in our data? We would love to hear from you.
      </p>

      <div class="flex items-center gap-3 mb-6">
        <svg class="w-6 h-6 text-[#2D8C3C] flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
        </svg>
        <a href="mailto:contact@caloriesin.net" class="text-lg text-[#2D8C3C] font-semibold underline hover:text-green-800">
          contact@caloriesin.net
        </a>
      </div>

      <p class="text-gray-600 mb-4">
        We typically respond within 1-2 business days. For data correction requests, please include
        the specific food name and the information you believe needs updating.
      </p>

      <p class="text-gray-600">
        You can also learn more about how CaloriesIn works and where our data comes from on our
        <a href="/about" class="text-[#2D8C3C] underline hover:text-green-800">About page</a>.
      </p>
    </div>
  </div>
</Layout>
