---
import { getCollection } from 'astro:content';
import Layout from '../../components/layout/Layout.astro';
import Breadcrumb from '../../components/layout/Breadcrumb.astro';
import ArticleSchema from '../../components/schema/ArticleSchema.astro';
import AdSlot from '../../components/monetization/AdSlot.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();

const categoryColors: Record<string, string> = {
  nutrition: 'bg-green-100 text-green-800',
  'weight-loss': 'bg-orange-100 text-orange-800',
  'meal-plans': 'bg-blue-100 text-blue-800',
  guides: 'bg-purple-100 text-purple-800',
};

const formattedDate = new Date(post.data.date).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<Layout
  title={`${post.data.title} — CaloriesIn`}
  description={post.data.description}
  canonical={`https://caloriesin.netlify.app/blog/${post.slug}`}
>
  <ArticleSchema
    title={post.data.title}
    description={post.data.description}
    datePublished={post.data.date}
    author={post.data.author}
    url={`https://caloriesin.netlify.app/blog/${post.slug}`}
  />

  <div class="mx-auto max-w-3xl px-4 py-8">
    <Breadcrumb
      items={[
        { label: 'Blog', href: '/blog' },
        { label: post.data.title },
      ]}
    />

    <article>
      <header class="mb-8">
        <div class="mb-3 flex items-center gap-3">
          <span class={`inline-block rounded-full px-2.5 py-0.5 text-xs font-medium ${categoryColors[post.data.category] || 'bg-gray-100 text-gray-800'}`}>
            {post.data.category}
          </span>
          <time class="text-sm text-text-muted" datetime={post.data.date}>
            {formattedDate}
          </time>
        </div>

        <h1 class="mb-3 text-3xl font-bold text-text-main md:text-4xl">
          {post.data.title}
        </h1>

        <p class="mb-4 text-lg text-text-muted">
          {post.data.description}
        </p>

        <div class="flex items-center gap-4 border-b border-border-main pb-4">
          <span class="text-sm text-text-main">
            By <strong>{post.data.author}</strong>
          </span>
          <div class="flex flex-wrap gap-1.5">
            {post.data.tags.map((tag: string) => (
              <span class="rounded bg-gray-100 px-2 py-0.5 text-xs text-text-muted">
                {tag}
              </span>
            ))}
          </div>
        </div>
      </header>

      <div class="blog-content">
        <Content />
      </div>

      <AdSlot slot="mid-article" />

      <div class="mt-8 rounded-lg border border-border-main bg-bg-alt p-6">
        <p class="text-sm text-text-muted">
          Published on {formattedDate} by {post.data.author}.
          The information in this article is for educational purposes and should not replace professional medical advice.
        </p>
      </div>

      <AdSlot slot="bottom-article" />
    </article>
  </div>
</Layout>

<style is:global>
  .blog-content h2 {
    font-size: 1.5rem;
    font-weight: 700;
    margin-top: 2rem;
    margin-bottom: 1rem;
    color: #1A1A1A;
    line-height: 1.3;
  }

  .blog-content h3 {
    font-size: 1.25rem;
    font-weight: 600;
    margin-top: 1.5rem;
    margin-bottom: 0.75rem;
    color: #1A1A1A;
    line-height: 1.4;
  }

  .blog-content p {
    margin-bottom: 1rem;
    line-height: 1.75;
    color: #374151;
  }

  .blog-content ul {
    list-style-type: disc;
    padding-left: 1.5rem;
    margin-bottom: 1rem;
  }

  .blog-content ol {
    list-style-type: decimal;
    padding-left: 1.5rem;
    margin-bottom: 1rem;
  }

  .blog-content li {
    margin-bottom: 0.5rem;
    line-height: 1.75;
    color: #374151;
  }

  .blog-content a {
    color: #2D8C3C;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .blog-content a:hover {
    color: #236e30;
  }

  .blog-content strong {
    font-weight: 600;
  }

  .blog-content blockquote {
    border-left: 4px solid #2D8C3C;
    padding-left: 1rem;
    margin: 1.5rem 0;
    color: #666666;
    font-style: italic;
  }

  .blog-content table {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 1.5rem;
  }

  .blog-content thead {
    background-color: #f3f4f6;
  }

  .blog-content th {
    padding: 0.75rem 1rem;
    text-align: left;
    font-weight: 600;
    font-size: 0.875rem;
    border: 1px solid #e5e7eb;
  }

  .blog-content td {
    padding: 0.75rem 1rem;
    font-size: 0.875rem;
    border: 1px solid #e5e7eb;
  }

  .blog-content tr:nth-child(even) {
    background-color: #f9fafb;
  }

  .blog-content hr {
    margin: 2rem 0;
    border: 0;
    border-top: 1px solid #e5e7eb;
  }
</style>
