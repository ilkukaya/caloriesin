---
import { getCollection } from 'astro:content';
import Layout from '../../components/layout/Layout.astro';
import Breadcrumb from '../../components/layout/Breadcrumb.astro';

const posts = (await getCollection('blog')).sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);

const categoryColors: Record<string, string> = {
  nutrition: 'bg-green-100 text-green-800',
  'weight-loss': 'bg-orange-100 text-orange-800',
  'meal-plans': 'bg-blue-100 text-blue-800',
  guides: 'bg-purple-100 text-purple-800',
};
---

<Layout
  title="Nutrition Blog — CaloriesIn"
  description="Expert articles on calories, nutrition, weight loss, and healthy eating. Learn how to count calories, find low-calorie foods, and reach your health goals."
  canonical="https://caloriesin.netlify.app/blog"
>
  <div class="mx-auto max-w-6xl px-4 py-8">
    <Breadcrumb items={[{ label: 'Blog' }]} />

    <h1 class="mb-2 text-3xl font-bold text-text-main md:text-4xl">
      Nutrition & Calorie Guides
    </h1>
    <p class="mb-8 text-lg text-text-muted">
      Expert advice on calories, nutrition, and healthy eating to help you reach your goals.
    </p>

    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {posts.map((post) => (
        <article class="flex flex-col overflow-hidden rounded-lg border border-border-main bg-white shadow-sm transition hover:shadow-md">
          <div class="flex flex-1 flex-col p-5">
            <div class="mb-3 flex items-center gap-2">
              <span class={`inline-block rounded-full px-2.5 py-0.5 text-xs font-medium ${categoryColors[post.data.category] || 'bg-gray-100 text-gray-800'}`}>
                {post.data.category}
              </span>
              <time class="text-xs text-text-muted" datetime={post.data.date}>
                {new Date(post.data.date).toLocaleDateString('en-US', {
                  year: 'numeric',
                  month: 'long',
                  day: 'numeric',
                })}
              </time>
            </div>

            <h2 class="mb-2 text-lg font-semibold text-text-main">
              <a href={`/blog/${post.slug}`} class="hover:text-primary transition-colors">
                {post.data.title}
              </a>
            </h2>

            <p class="mb-4 flex-1 text-sm leading-relaxed text-text-muted">
              {post.data.description}
            </p>

            <div class="flex flex-wrap gap-1.5">
              {post.data.tags.map((tag: string) => (
                <span class="rounded bg-gray-100 px-2 py-0.5 text-xs text-text-muted">
                  {tag}
                </span>
              ))}
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</Layout>
