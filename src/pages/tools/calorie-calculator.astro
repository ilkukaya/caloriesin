---
import Layout from '../../components/layout/Layout.astro';
import Breadcrumb from '../../components/layout/Breadcrumb.astro';
import AdSlot from '../../components/monetization/AdSlot.astro';
import AffiliateBanner from '../../components/monetization/AffiliateBanner.astro';

const title = 'Calorie Calculator — How Many Calories Should I Eat? | CaloriesIn';
const description = 'Use our free calorie calculator to find your daily calorie needs based on the Mifflin-St Jeor formula. Get your BMR, TDEE, and calorie targets for weight loss or gain.';
const canonical = '/tools/calorie-calculator';
---

<Layout title={title} description={description} canonical={canonical}>
  <div class="mx-auto max-w-4xl px-4 py-6">
    <Breadcrumb items={[
      { label: 'Tools', href: '/tools' },
      { label: 'Calorie Calculator' },
    ]} />

    <h1 class="mt-4 text-3xl font-bold text-text-main md:text-4xl">Daily Calorie Calculator</h1>
    <p class="mt-2 text-text-muted">Find out how many calories you need each day to maintain, lose, or gain weight using the scientifically-backed Mifflin-St Jeor equation.</p>

    <!-- Calculator Card -->
    <div class="mt-8 rounded-xl border border-border-main bg-white p-6 shadow-sm md:p-8">
      <form id="calorie-form" class="space-y-6" onsubmit="return false;">

        <!-- Gender -->
        <fieldset>
          <legend class="mb-2 text-sm font-semibold text-text-main">Gender</legend>
          <div class="flex gap-4">
            <label class="flex cursor-pointer items-center gap-2 rounded-lg border border-border-main px-4 py-2.5 transition-colors has-[:checked]:border-primary has-[:checked]:bg-primary-light">
              <input type="radio" name="gender" value="male" checked class="accent-primary" />
              <span class="text-sm font-medium">Male</span>
            </label>
            <label class="flex cursor-pointer items-center gap-2 rounded-lg border border-border-main px-4 py-2.5 transition-colors has-[:checked]:border-primary has-[:checked]:bg-primary-light">
              <input type="radio" name="gender" value="female" class="accent-primary" />
              <span class="text-sm font-medium">Female</span>
            </label>
          </div>
        </fieldset>

        <!-- Age -->
        <div>
          <label for="age" class="mb-1 block text-sm font-semibold text-text-main">Age</label>
          <div class="flex items-center gap-2">
            <input type="number" id="age" min="15" max="120" placeholder="25" required
              class="w-28 rounded-lg border border-border-main px-3 py-2.5 text-sm focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary" />
            <span class="text-sm text-text-muted">years</span>
          </div>
        </div>

        <!-- Weight -->
        <div>
          <label for="weight" class="mb-1 block text-sm font-semibold text-text-main">Weight</label>
          <div class="flex items-center gap-2">
            <input type="number" id="weight" min="1" step="0.1" placeholder="150" required
              class="w-28 rounded-lg border border-border-main px-3 py-2.5 text-sm focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary" />
            <div class="flex rounded-lg border border-border-main text-sm">
              <button type="button" id="weight-lbs-btn" class="rounded-l-lg px-3 py-2 font-medium bg-primary text-white" onclick="setWeightUnit('lbs')">lbs</button>
              <button type="button" id="weight-kg-btn" class="rounded-r-lg px-3 py-2 font-medium text-text-muted" onclick="setWeightUnit('kg')">kg</button>
            </div>
          </div>
        </div>

        <!-- Height -->
        <div>
          <label class="mb-1 block text-sm font-semibold text-text-main">Height</label>
          <div class="flex items-center gap-2">
            <div id="height-imperial" class="flex items-center gap-2">
              <input type="number" id="height-ft" min="1" max="8" placeholder="5" required
                class="w-20 rounded-lg border border-border-main px-3 py-2.5 text-sm focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary" />
              <span class="text-sm text-text-muted">ft</span>
              <input type="number" id="height-in" min="0" max="11" placeholder="8" required
                class="w-20 rounded-lg border border-border-main px-3 py-2.5 text-sm focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary" />
              <span class="text-sm text-text-muted">in</span>
            </div>
            <div id="height-metric" class="hidden flex items-center gap-2">
              <input type="number" id="height-cm" min="50" max="300" placeholder="173"
                class="w-28 rounded-lg border border-border-main px-3 py-2.5 text-sm focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary" />
              <span class="text-sm text-text-muted">cm</span>
            </div>
            <div class="flex rounded-lg border border-border-main text-sm">
              <button type="button" id="height-ftin-btn" class="rounded-l-lg px-3 py-2 font-medium bg-primary text-white" onclick="setHeightUnit('ftin')">ft/in</button>
              <button type="button" id="height-cm-btn" class="rounded-r-lg px-3 py-2 font-medium text-text-muted" onclick="setHeightUnit('cm')">cm</button>
            </div>
          </div>
        </div>

        <!-- Activity Level -->
        <div>
          <label for="activity" class="mb-1 block text-sm font-semibold text-text-main">Activity Level</label>
          <select id="activity" required
            class="w-full rounded-lg border border-border-main px-3 py-2.5 text-sm focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary">
            <option value="1.2">Sedentary (little or no exercise)</option>
            <option value="1.375">Lightly Active (1-3 days/week)</option>
            <option value="1.55" selected>Moderately Active (3-5 days/week)</option>
            <option value="1.725">Very Active (6-7 days/week)</option>
            <option value="1.9">Extra Active (very hard exercise)</option>
          </select>
        </div>

        <!-- Calculate Button -->
        <button type="button" id="calculate-btn" onclick="calculateCalories()"
          class="w-full rounded-lg bg-accent px-6 py-3.5 text-base font-bold text-white shadow-sm transition-colors hover:bg-orange-600 focus:outline-none focus:ring-2 focus:ring-accent focus:ring-offset-2 md:w-auto md:px-10">
          Calculate Calories
        </button>
      </form>
    </div>

    <!-- Results Section -->
    <div id="results" class="mt-8 hidden">
      <h2 class="text-xl font-bold text-text-main">Your Daily Calorie Needs</h2>

      <!-- BMR -->
      <div class="mt-4 rounded-lg border border-border-main bg-bg-alt p-4">
        <p class="text-sm text-text-muted">Basal Metabolic Rate (BMR)</p>
        <p class="text-2xl font-bold text-text-main"><span id="result-bmr">0</span> <span class="text-base font-normal text-text-muted">calories/day</span></p>
      </div>

      <!-- TDEE & Goal Cards -->
      <div class="mt-4 grid gap-4 sm:grid-cols-3">
        <!-- Weight Loss -->
        <div class="rounded-lg border-2 border-primary bg-primary-light p-5 text-center">
          <p class="text-sm font-semibold text-primary-dark">Weight Loss</p>
          <p class="mt-1 text-3xl font-bold text-primary-dark" id="result-loss">0</p>
          <p class="mt-1 text-xs text-primary-dark/70">-500 cal/day (~1 lb/week)</p>
          <div class="mt-2 border-t border-primary/20 pt-2">
            <p class="text-sm font-semibold text-primary-dark">Mild Loss</p>
            <p class="text-xl font-bold text-primary-dark" id="result-mild-loss">0</p>
            <p class="text-xs text-primary-dark/70">-250 cal/day (~0.5 lb/week)</p>
          </div>
        </div>

        <!-- Maintenance -->
        <div class="rounded-lg border-2 border-info bg-blue-50 p-5 text-center">
          <p class="text-sm font-semibold text-blue-800">Maintenance</p>
          <p class="mt-1 text-3xl font-bold text-blue-800" id="result-maintain">0</p>
          <p class="mt-1 text-xs text-blue-700/70">TDEE — maintain weight</p>
        </div>

        <!-- Weight Gain -->
        <div class="rounded-lg border-2 border-accent bg-accent-light p-5 text-center">
          <p class="text-sm font-semibold text-orange-800">Weight Gain</p>
          <p class="mt-1 text-3xl font-bold text-orange-800" id="result-gain">0</p>
          <p class="mt-1 text-xs text-orange-700/70">+500 cal/day (~1 lb/week)</p>
        </div>
      </div>
    </div>

    <!-- Explanation -->
    <div class="mt-10 rounded-xl border border-border-main bg-white p-6 md:p-8">
      <h2 class="text-xl font-bold text-text-main">How Is This Calculated?</h2>
      <div class="mt-3 space-y-3 text-sm leading-relaxed text-text-muted">
        <p>
          This calculator uses the <strong class="text-text-main">Mifflin-St Jeor equation</strong>, which is considered one of the most accurate formulas for estimating Basal Metabolic Rate (BMR) — the number of calories your body burns at rest.
        </p>
        <p>
          <strong class="text-text-main">For men:</strong> BMR = 10 &times; weight (kg) + 6.25 &times; height (cm) &minus; 5 &times; age &minus; 5<br />
          <strong class="text-text-main">For women:</strong> BMR = 10 &times; weight (kg) + 6.25 &times; height (cm) &minus; 5 &times; age &minus; 161
        </p>
        <p>
          Your Total Daily Energy Expenditure (TDEE) is then calculated by multiplying your BMR by an activity factor that accounts for how much you move throughout the day. To lose weight, you need to eat fewer calories than your TDEE; to gain weight, eat more.
        </p>
        <p>
          A deficit of roughly 500 calories per day corresponds to about 1 pound of weight loss per week, while a 250-calorie deficit yields about 0.5 pounds per week. These are general guidelines — individual results may vary.
        </p>
      </div>
    </div>

    <!-- Affiliate Banner -->
    <div class="mt-8">
      <AffiliateBanner
        name="MyFitnessPal"
        description="Track your daily calories and macros effortlessly. The most popular calorie-counting app with a database of over 14 million foods."
        ctaText="Track Your Calories"
        ctaUrl="#"
        logo="📱"
      />
    </div>

    <!-- Ad Slot -->
    <AdSlot slot="calorie-calculator-bottom" />
  </div>
</Layout>

<script is:inline>
  var weightUnit = 'lbs';
  var heightUnit = 'ftin';

  function setWeightUnit(unit) {
    weightUnit = unit;
    var lbsBtn = document.getElementById('weight-lbs-btn');
    var kgBtn = document.getElementById('weight-kg-btn');
    if (unit === 'lbs') {
      lbsBtn.className = 'rounded-l-lg px-3 py-2 font-medium bg-primary text-white';
      kgBtn.className = 'rounded-r-lg px-3 py-2 font-medium text-text-muted';
    } else {
      lbsBtn.className = 'rounded-l-lg px-3 py-2 font-medium text-text-muted';
      kgBtn.className = 'rounded-r-lg px-3 py-2 font-medium bg-primary text-white';
    }
  }

  function setHeightUnit(unit) {
    heightUnit = unit;
    var ftinBtn = document.getElementById('height-ftin-btn');
    var cmBtn = document.getElementById('height-cm-btn');
    var imperialDiv = document.getElementById('height-imperial');
    var metricDiv = document.getElementById('height-metric');
    if (unit === 'ftin') {
      ftinBtn.className = 'rounded-l-lg px-3 py-2 font-medium bg-primary text-white';
      cmBtn.className = 'rounded-r-lg px-3 py-2 font-medium text-text-muted';
      imperialDiv.classList.remove('hidden');
      metricDiv.classList.add('hidden');
      document.getElementById('height-ft').required = true;
      document.getElementById('height-in').required = true;
      document.getElementById('height-cm').required = false;
    } else {
      ftinBtn.className = 'rounded-l-lg px-3 py-2 font-medium text-text-muted';
      cmBtn.className = 'rounded-r-lg px-3 py-2 font-medium bg-primary text-white';
      imperialDiv.classList.add('hidden');
      metricDiv.classList.remove('hidden');
      document.getElementById('height-ft').required = false;
      document.getElementById('height-in').required = false;
      document.getElementById('height-cm').required = true;
    }
  }

  function calculateCalories() {
    var gender = document.querySelector('input[name="gender"]:checked').value;
    var age = parseFloat(document.getElementById('age').value);
    var weightVal = parseFloat(document.getElementById('weight').value);
    var activity = parseFloat(document.getElementById('activity').value);

    if (!age || !weightVal) {
      alert('Please fill in all fields.');
      return;
    }

    // Convert weight to kg
    var weightKg = weightUnit === 'lbs' ? weightVal * 0.453592 : weightVal;

    // Get height in cm
    var heightCm;
    if (heightUnit === 'ftin') {
      var ft = parseFloat(document.getElementById('height-ft').value) || 0;
      var inches = parseFloat(document.getElementById('height-in').value) || 0;
      if (!ft) {
        alert('Please enter your height.');
        return;
      }
      heightCm = (ft * 12 + inches) * 2.54;
    } else {
      heightCm = parseFloat(document.getElementById('height-cm').value);
      if (!heightCm) {
        alert('Please enter your height.');
        return;
      }
    }

    // Mifflin-St Jeor
    var bmr;
    if (gender === 'male') {
      bmr = 10 * weightKg + 6.25 * heightCm - 5 * age - 5;
    } else {
      bmr = 10 * weightKg + 6.25 * heightCm - 5 * age - 161;
    }

    var tdee = bmr * activity;

    // Display results
    document.getElementById('result-bmr').textContent = Math.round(bmr).toLocaleString();
    document.getElementById('result-maintain').textContent = Math.round(tdee).toLocaleString();
    document.getElementById('result-loss').textContent = Math.round(tdee - 500).toLocaleString();
    document.getElementById('result-mild-loss').textContent = Math.round(tdee - 250).toLocaleString();
    document.getElementById('result-gain').textContent = Math.round(tdee + 500).toLocaleString();

    document.getElementById('results').classList.remove('hidden');
    document.getElementById('results').scrollIntoView({ behavior: 'smooth', block: 'start' });
  }
</script>
