---
import Layout from '../../components/layout/Layout.astro';
import Breadcrumb from '../../components/layout/Breadcrumb.astro';
import AdSlot from '../../components/monetization/AdSlot.astro';

const title = 'BMI Calculator — Check Your Body Mass Index | CaloriesIn';
const description = 'Calculate your Body Mass Index (BMI) instantly with our free BMI calculator. Find out if you are underweight, normal weight, overweight, or obese.';
const canonical = 'https://caloriesin.netlify.app/tools/bmi-calculator';
---

<Layout title={title} description={description} canonical={canonical}>
  <div class="mx-auto max-w-4xl px-4 py-6">
    <Breadcrumb items={[
      { label: 'Tools', href: '/tools' },
      { label: 'BMI Calculator' },
    ]} />

    <h1 class="mt-4 text-3xl font-bold text-text-main md:text-4xl">BMI Calculator</h1>
    <p class="mt-2 text-text-muted">Check your Body Mass Index to see where you fall on the weight spectrum. BMI is a quick screening tool based on your height and weight.</p>

    <!-- Calculator Card -->
    <div class="mt-8 rounded-xl border border-border-main bg-white p-6 shadow-sm md:p-8">
      <form id="bmi-form" class="space-y-6" onsubmit="return false;">

        <!-- Weight -->
        <div>
          <label for="bmi-weight" class="mb-1 block text-sm font-semibold text-text-main">Weight</label>
          <div class="flex items-center gap-2">
            <input type="number" id="bmi-weight" min="1" step="0.1" placeholder="150" required
              class="w-28 rounded-lg border border-border-main px-3 py-2.5 text-sm focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary" />
            <div class="flex rounded-lg border border-border-main text-sm">
              <button type="button" id="bmi-weight-lbs-btn" class="rounded-l-lg px-3 py-2 font-medium bg-primary text-white" onclick="setBmiWeightUnit('lbs')">lbs</button>
              <button type="button" id="bmi-weight-kg-btn" class="rounded-r-lg px-3 py-2 font-medium text-text-muted" onclick="setBmiWeightUnit('kg')">kg</button>
            </div>
          </div>
        </div>

        <!-- Height -->
        <div>
          <label class="mb-1 block text-sm font-semibold text-text-main">Height</label>
          <div class="flex items-center gap-2">
            <div id="bmi-height-imperial" class="flex items-center gap-2">
              <input type="number" id="bmi-height-ft" min="1" max="8" placeholder="5" required
                class="w-20 rounded-lg border border-border-main px-3 py-2.5 text-sm focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary" />
              <span class="text-sm text-text-muted">ft</span>
              <input type="number" id="bmi-height-in" min="0" max="11" placeholder="8" required
                class="w-20 rounded-lg border border-border-main px-3 py-2.5 text-sm focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary" />
              <span class="text-sm text-text-muted">in</span>
            </div>
            <div id="bmi-height-metric" class="hidden flex items-center gap-2">
              <input type="number" id="bmi-height-cm" min="50" max="300" placeholder="173"
                class="w-28 rounded-lg border border-border-main px-3 py-2.5 text-sm focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary" />
              <span class="text-sm text-text-muted">cm</span>
            </div>
            <div class="flex rounded-lg border border-border-main text-sm">
              <button type="button" id="bmi-height-ftin-btn" class="rounded-l-lg px-3 py-2 font-medium bg-primary text-white" onclick="setBmiHeightUnit('ftin')">ft/in</button>
              <button type="button" id="bmi-height-cm-btn" class="rounded-r-lg px-3 py-2 font-medium text-text-muted" onclick="setBmiHeightUnit('cm')">cm</button>
            </div>
          </div>
        </div>

        <!-- Calculate Button -->
        <button type="button" id="bmi-calculate-btn" onclick="calculateBMI()"
          class="w-full rounded-lg bg-accent px-6 py-3.5 text-base font-bold text-white shadow-sm transition-colors hover:bg-orange-600 focus:outline-none focus:ring-2 focus:ring-accent focus:ring-offset-2 md:w-auto md:px-10">
          Calculate BMI
        </button>
      </form>
    </div>

    <!-- Results Section -->
    <div id="bmi-results" class="mt-8 hidden">
      <h2 class="text-xl font-bold text-text-main">Your BMI Result</h2>

      <!-- BMI Value -->
      <div class="mt-4 rounded-lg border border-border-main bg-white p-6 text-center shadow-sm">
        <p class="text-sm text-text-muted">Your Body Mass Index</p>
        <p class="mt-1 text-5xl font-bold" id="bmi-value">0</p>
        <p class="mt-2 text-lg font-semibold" id="bmi-category">—</p>
      </div>

      <!-- BMI Scale Bar -->
      <div class="mt-6 rounded-lg border border-border-main bg-white p-6 shadow-sm">
        <p class="mb-3 text-sm font-semibold text-text-main">BMI Scale</p>
        <div class="relative">
          <!-- Gradient bar -->
          <div class="h-6 w-full rounded-full overflow-hidden" style="background: linear-gradient(to right, #2196F3 0%, #2196F3 23.1%, #4CAF50 23.1%, #4CAF50 43.4%, #FFC107 43.4%, #FFC107 65.2%, #F44336 65.2%, #F44336 100%);">
          </div>
          <!-- Marker -->
          <div id="bmi-marker" class="absolute top-0 -mt-1 flex flex-col items-center" style="left: 50%; transform: translateX(-50%);">
            <div class="w-0 h-0 border-l-[6px] border-r-[6px] border-t-[8px] border-l-transparent border-r-transparent border-t-text-main"></div>
            <div class="h-8 w-0.5 bg-text-main"></div>
          </div>
          <!-- Labels -->
          <div class="mt-2 flex text-xs text-text-muted">
            <div class="flex-1 text-center" style="flex-basis: 23.1%;">
              <span class="font-medium text-blue-600">Underweight</span><br />&lt;18.5
            </div>
            <div class="flex-1 text-center" style="flex-basis: 20.3%;">
              <span class="font-medium text-green-600">Normal</span><br />18.5–24.9
            </div>
            <div class="flex-1 text-center" style="flex-basis: 21.8%;">
              <span class="font-medium text-yellow-600">Overweight</span><br />25–29.9
            </div>
            <div class="flex-1 text-center" style="flex-basis: 34.8%;">
              <span class="font-medium text-red-600">Obese</span><br />30+
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Explanation -->
    <div class="mt-10 rounded-xl border border-border-main bg-white p-6 md:p-8">
      <h2 class="text-xl font-bold text-text-main">How Is BMI Calculated?</h2>
      <div class="mt-3 space-y-3 text-sm leading-relaxed text-text-muted">
        <p>
          <strong class="text-text-main">Body Mass Index (BMI)</strong> is calculated by dividing your weight in kilograms by the square of your height in meters:
        </p>
        <p class="rounded-lg bg-bg-alt p-3 font-mono text-text-main">
          BMI = weight (kg) &divide; height (m)&sup2;
        </p>
        <p>
          BMI is a useful screening tool, but it does not directly measure body fat. Factors such as muscle mass, bone density, age, and sex can influence results. Athletes, for example, may have a high BMI due to muscle rather than excess fat.
        </p>
        <p>
          <strong class="text-text-main">BMI Categories (WHO):</strong>
        </p>
        <ul class="ml-4 list-disc space-y-1">
          <li><span class="font-medium text-blue-600">Underweight:</span> BMI less than 18.5</li>
          <li><span class="font-medium text-green-600">Normal weight:</span> BMI 18.5 – 24.9</li>
          <li><span class="font-medium text-yellow-600">Overweight:</span> BMI 25 – 29.9</li>
          <li><span class="font-medium text-red-600">Obese:</span> BMI 30 or greater</li>
        </ul>
        <p>
          For a more complete picture of your health, consider speaking with a healthcare professional who can evaluate additional factors beyond BMI.
        </p>
      </div>
    </div>

    <!-- Ad Slot -->
    <AdSlot slot="bmi-calculator-bottom" />
  </div>
</Layout>

<script is:inline>
  var bmiWeightUnit = 'lbs';
  var bmiHeightUnit = 'ftin';

  function setBmiWeightUnit(unit) {
    bmiWeightUnit = unit;
    var lbsBtn = document.getElementById('bmi-weight-lbs-btn');
    var kgBtn = document.getElementById('bmi-weight-kg-btn');
    if (unit === 'lbs') {
      lbsBtn.className = 'rounded-l-lg px-3 py-2 font-medium bg-primary text-white';
      kgBtn.className = 'rounded-r-lg px-3 py-2 font-medium text-text-muted';
    } else {
      lbsBtn.className = 'rounded-l-lg px-3 py-2 font-medium text-text-muted';
      kgBtn.className = 'rounded-r-lg px-3 py-2 font-medium bg-primary text-white';
    }
  }

  function setBmiHeightUnit(unit) {
    bmiHeightUnit = unit;
    var ftinBtn = document.getElementById('bmi-height-ftin-btn');
    var cmBtn = document.getElementById('bmi-height-cm-btn');
    var imperialDiv = document.getElementById('bmi-height-imperial');
    var metricDiv = document.getElementById('bmi-height-metric');
    if (unit === 'ftin') {
      ftinBtn.className = 'rounded-l-lg px-3 py-2 font-medium bg-primary text-white';
      cmBtn.className = 'rounded-r-lg px-3 py-2 font-medium text-text-muted';
      imperialDiv.classList.remove('hidden');
      metricDiv.classList.add('hidden');
      document.getElementById('bmi-height-ft').required = true;
      document.getElementById('bmi-height-in').required = true;
      document.getElementById('bmi-height-cm').required = false;
    } else {
      ftinBtn.className = 'rounded-l-lg px-3 py-2 font-medium text-text-muted';
      cmBtn.className = 'rounded-r-lg px-3 py-2 font-medium bg-primary text-white';
      imperialDiv.classList.add('hidden');
      metricDiv.classList.remove('hidden');
      document.getElementById('bmi-height-ft').required = false;
      document.getElementById('bmi-height-in').required = false;
      document.getElementById('bmi-height-cm').required = true;
    }
  }

  function calculateBMI() {
    var weightVal = parseFloat(document.getElementById('bmi-weight').value);

    if (!weightVal) {
      alert('Please enter your weight.');
      return;
    }

    // Convert weight to kg
    var weightKg = bmiWeightUnit === 'lbs' ? weightVal * 0.453592 : weightVal;

    // Get height in cm
    var heightCm;
    if (bmiHeightUnit === 'ftin') {
      var ft = parseFloat(document.getElementById('bmi-height-ft').value) || 0;
      var inches = parseFloat(document.getElementById('bmi-height-in').value) || 0;
      if (!ft) {
        alert('Please enter your height.');
        return;
      }
      heightCm = (ft * 12 + inches) * 2.54;
    } else {
      heightCm = parseFloat(document.getElementById('bmi-height-cm').value);
      if (!heightCm) {
        alert('Please enter your height.');
        return;
      }
    }

    // Calculate BMI
    var heightM = heightCm / 100;
    var bmi = weightKg / (heightM * heightM);
    var bmiRounded = Math.round(bmi * 10) / 10;

    // Determine category and colors
    var category, colorClass;
    if (bmi < 18.5) {
      category = 'Underweight';
      colorClass = 'text-blue-600';
    } else if (bmi < 25) {
      category = 'Normal Weight';
      colorClass = 'text-green-600';
    } else if (bmi < 30) {
      category = 'Overweight';
      colorClass = 'text-yellow-600';
    } else {
      category = 'Obese';
      colorClass = 'text-red-600';
    }

    // Display results
    var bmiValueEl = document.getElementById('bmi-value');
    bmiValueEl.textContent = bmiRounded;
    bmiValueEl.className = 'mt-1 text-5xl font-bold ' + colorClass;

    var bmiCategoryEl = document.getElementById('bmi-category');
    bmiCategoryEl.textContent = category;
    bmiCategoryEl.className = 'mt-2 text-lg font-semibold ' + colorClass;

    // Position the marker on the scale bar
    // Scale: BMI 10 to 40 mapped to 0% to 100%
    var minBmi = 10;
    var maxBmi = 40;
    var pct = ((Math.min(Math.max(bmi, minBmi), maxBmi) - minBmi) / (maxBmi - minBmi)) * 100;
    var marker = document.getElementById('bmi-marker');
    marker.style.left = pct + '%';

    document.getElementById('bmi-results').classList.remove('hidden');
    document.getElementById('bmi-results').scrollIntoView({ behavior: 'smooth', block: 'start' });
  }
</script>
