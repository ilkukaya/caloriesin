---
import Layout from '../components/layout/Layout.astro';
import PopularSearches from '../components/shared/PopularSearches.astro';
import FoodCard from '../components/shared/FoodCard.astro';
import CategoryCard from '../components/category/CategoryCard.astro';
import WebSiteSchema from '../components/schema/WebSiteSchema.astro';

let foods: any[] = [];
let categories: any[] = [];

try {
  foods = (await import('../data/foods.json')).default ?? [];
} catch {
  foods = [];
}

try {
  categories = (await import('../data/categories.json')).default ?? [];
} catch {
  categories = [];
}

const topFoods = foods.slice(0, 50);

const siteUrl = 'https://caloriesin.netlify.app';

const emojiMap: Record<string, string> = {
  fruits: '🍎',
  vegetables: '🥦',
  meats: '🥩',
  seafood: '🐟',
  dairy: '🥛',
  grains: '🌾',
  legumes: '🫘',
  'nuts-and-seeds': '🥜',
  beverages: '🥤',
  snacks: '🍰',
  condiments: '🧂',
  'fast-food': '🍕',
};

const description =
  'Find calorie counts, macros, and nutritional info for thousands of foods. Search our database of fruits, vegetables, meats, and more.';
---

<Layout
  title="CaloriesIn — How Many Calories In Your Favorite Food?"
  description={description}
  canonical={siteUrl}
>
  <WebSiteSchema siteUrl={siteUrl} />

  <!-- Hero / Search -->
  <section class="bg-primary-light py-16 md:py-24">
    <div class="mx-auto max-w-3xl px-4 text-center">
      <h1 class="mb-6 text-4xl font-bold text-text-main md:text-5xl">
        How Many Calories Are In Your Food?
      </h1>
      <p class="mb-8 text-lg text-text-muted">
        Search our database of thousands of foods to find calories, macros, and
        nutritional information.
      </p>
      <form action="/search" method="get" class="flex gap-2">
        <input
          type="text"
          name="q"
          placeholder="Search for a food... (e.g., banana, chicken breast)"
          class="flex-1 rounded-lg border border-border-main bg-white px-5 py-3 text-base text-text-main shadow-sm placeholder:text-text-muted/60 focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20"
          autocomplete="off"
        />
        <button
          type="submit"
          class="rounded-lg bg-primary px-6 py-3 font-semibold text-white shadow-sm transition-colors hover:bg-primary-dark"
        >
          Search
        </button>
      </form>
    </div>
  </section>

  <!-- Popular Searches -->
  <section class="mx-auto max-w-5xl px-4 py-12">
    <h2 class="mb-4 text-lg font-semibold text-text-main">Popular Searches</h2>
    <PopularSearches />
  </section>

  <!-- Food Categories -->
  {categories.length > 0 && (
    <section class="bg-bg-alt py-12">
      <div class="mx-auto max-w-5xl px-4">
        <h2 class="mb-6 text-2xl font-bold text-text-main">
          Browse by Category
        </h2>
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {categories.map((cat) => (
            <CategoryCard
              name={cat.name}
              slug={cat.slug}
              count={cat.count ?? 0}
              emoji={emojiMap[cat.slug] ?? '🍽️'}
            />
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Quick Calorie Cards -->
  {topFoods.length > 0 && (
    <section class="mx-auto max-w-5xl px-4 py-12">
      <h2 class="mb-6 text-2xl font-bold text-text-main">Popular Foods</h2>
      <div class="grid grid-cols-2 gap-3 md:grid-cols-3 lg:grid-cols-4">
        {topFoods.map((food) => (
          <FoodCard
            name={food.name}
            slug={food.slug}
            calories={food.calories}
            category={food.category}
          />
        ))}
      </div>
    </section>
  )}

  <!-- Tools Section -->
  <section class="bg-bg-alt py-12">
    <div class="mx-auto max-w-5xl px-4">
      <h2 class="mb-6 text-2xl font-bold text-text-main">
        Nutrition Tools
      </h2>
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-3">
        <a
          href="/tools/calorie-calculator"
          class="group rounded-xl border border-border-main bg-white p-6 transition-all hover:border-primary hover:shadow-md"
        >
          <div class="mb-3 text-3xl">🔥</div>
          <h3 class="text-lg font-semibold text-text-main group-hover:text-primary transition-colors">
            Calorie Calculator
          </h3>
          <p class="mt-2 text-sm text-text-muted">
            Calculate your daily calorie needs based on your age, weight,
            height, and activity level.
          </p>
        </a>
        <a
          href="/tools/bmi-calculator"
          class="group rounded-xl border border-border-main bg-white p-6 transition-all hover:border-primary hover:shadow-md"
        >
          <div class="mb-3 text-3xl">⚖️</div>
          <h3 class="text-lg font-semibold text-text-main group-hover:text-primary transition-colors">
            BMI Calculator
          </h3>
          <p class="mt-2 text-sm text-text-muted">
            Find out your Body Mass Index and see where you fall on the healthy
            weight scale.
          </p>
        </a>
        <a
          href="/tools/macro-calculator"
          class="group rounded-xl border border-border-main bg-white p-6 transition-all hover:border-primary hover:shadow-md"
        >
          <div class="mb-3 text-3xl">📊</div>
          <h3 class="text-lg font-semibold text-text-main group-hover:text-primary transition-colors">
            Macro Calculator
          </h3>
          <p class="mt-2 text-sm text-text-muted">
            Get personalized protein, carb, and fat targets to match your
            fitness goals.
          </p>
        </a>
      </div>
    </div>
  </section>
</Layout>
