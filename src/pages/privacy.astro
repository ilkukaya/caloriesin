---
import Layout from '../components/layout/Layout.astro';

const title = 'Privacy Policy | CaloriesIn';
const description = 'Privacy policy for CaloriesIn. Learn how we collect, use, and protect your data when you use our calorie and nutrition database.';
const canonical = 'https://caloriesin.netlify.app/privacy';
---

<Layout title={title} description={description} canonical={canonical}>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <h1 class="text-3xl sm:text-4xl font-bold text-gray-900 mb-2">Privacy Policy</h1>
    <p class="text-sm text-gray-500 mb-8">Last updated: April 2026</p>

    <div class="prose prose-lg max-w-none text-gray-700 space-y-6">
      <p>
        This Privacy Policy explains how CaloriesIn ("we", "us", or "our") collects, uses, and
        protects information when you visit our website at caloriesin.netlify.app (the "Site").
      </p>

      <section>
        <h2 class="text-xl font-semibold text-gray-900 mt-8 mb-3">Information We Collect</h2>
        <p>
          We do not require you to create an account or provide personal information to use
          CaloriesIn. However, we may collect certain data automatically when you visit the Site:
        </p>
        <ul class="list-disc pl-6 space-y-2 mt-3">
          <li>
            <strong>Analytics Data:</strong> We use Google Analytics 4 (GA4) to collect anonymized
            usage data such as pages visited, time spent on site, device type, browser, approximate
            geographic location, and referral sources. This helps us understand how visitors use the
            Site so we can improve it.
          </li>
          <li>
            <strong>Cookies:</strong> Google Analytics uses cookies to distinguish unique users and
            track sessions. These cookies do not contain personally identifiable information.
          </li>
        </ul>
      </section>

      <section>
        <h2 class="text-xl font-semibold text-gray-900 mt-8 mb-3">Google AdSense</h2>
        <p>
          We may display advertisements through Google AdSense. Google AdSense uses cookies and web
          beacons to serve ads based on your prior visits to this and other websites. Google's use
          of advertising cookies enables it and its partners to serve ads based on your browsing
          history. You may opt out of personalized advertising by visiting
          <a href="https://www.google.com/settings/ads" target="_blank" rel="noopener noreferrer" class="text-[#2D8C3C] underline hover:text-green-800">Google Ads Settings</a>.
        </p>
      </section>

      <section>
        <h2 class="text-xl font-semibold text-gray-900 mt-8 mb-3">Affiliate Links</h2>
        <p>
          Some links on CaloriesIn may be affiliate links. When you click an affiliate link and make
          a purchase, we may earn a small commission at no additional cost to you. Affiliate partners
          may use cookies to track referrals. These cookies are governed by the respective affiliate
          partner's privacy policy.
        </p>
      </section>

      <section>
        <h2 class="text-xl font-semibold text-gray-900 mt-8 mb-3">Third-Party Services</h2>
        <p>We use the following third-party services:</p>
        <ul class="list-disc pl-6 space-y-2 mt-3">
          <li><strong>Google Analytics 4</strong> — website analytics and traffic measurement</li>
          <li><strong>Google AdSense</strong> — advertising</li>
          <li><strong>Netlify</strong> — website hosting</li>
        </ul>
        <p class="mt-3">
          Each of these services has its own privacy policy governing how it handles data. We
          encourage you to review their policies.
        </p>
      </section>

      <section>
        <h2 class="text-xl font-semibold text-gray-900 mt-8 mb-3">USDA Data Attribution</h2>
        <p>
          All nutrition data displayed on CaloriesIn is sourced from the
          <a href="https://fdc.nal.usda.gov/" target="_blank" rel="noopener noreferrer" class="text-[#2D8C3C] underline hover:text-green-800">USDA FoodData Central</a>.
          This data is public domain and provided by the U.S. Department of Agriculture.
        </p>
      </section>

      <section>
        <h2 class="text-xl font-semibold text-gray-900 mt-8 mb-3">Your Rights</h2>
        <p>
          Since we do not collect personally identifiable information directly, there is typically no
          personal data for us to delete or export. However, you have the right to:
        </p>
        <ul class="list-disc pl-6 space-y-2 mt-3">
          <li>Opt out of Google Analytics tracking by installing the <a href="https://tools.google.com/dlpage/gaoptout" target="_blank" rel="noopener noreferrer" class="text-[#2D8C3C] underline hover:text-green-800">Google Analytics Opt-Out Browser Add-on</a>.</li>
          <li>Disable cookies in your browser settings.</li>
          <li>Contact us with any data-related requests or questions.</li>
        </ul>
      </section>

      <section>
        <h2 class="text-xl font-semibold text-gray-900 mt-8 mb-3">Contact</h2>
        <p>
          If you have questions about this Privacy Policy or wish to make a data request, please
          contact us at
          <a href="mailto:contact@caloriesin.net" class="text-[#2D8C3C] underline hover:text-green-800">contact@caloriesin.net</a>.
        </p>
      </section>

      <section>
        <h2 class="text-xl font-semibold text-gray-900 mt-8 mb-3">Changes to This Policy</h2>
        <p>
          We may update this Privacy Policy from time to time. Any changes will be posted on this
          page with an updated revision date. We encourage you to review this page periodically.
        </p>
      </section>
    </div>
  </div>
</Layout>
