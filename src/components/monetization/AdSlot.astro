---
interface Props {
  slot: string;
  format?: string;
}

const { slot, format = 'auto' } = Astro.props;
---

<div class="my-6" data-ad-slot={slot}>
  <!-- Development placeholder -->
  <div class="flex min-h-[90px] items-center justify-center rounded border border-dashed border-border-main bg-bg-alt">
    <span class="text-xs text-text-muted">Advertisement</span>
  </div>

