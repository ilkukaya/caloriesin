---
import type { Food } from '../../utils/nutrition';

interface Props {
  food1: Food;
  food2: Food;
}

const { food1, food2 } = Astro.props;

interface NutrientRow {
  label: string;
  unit: string;
  value1: number;
  value2: number;
  higherIsBetter: boolean;
}

const rows: NutrientRow[] = [
  { label: 'Calories', unit: 'kcal', value1: food1.calories, value2: food2.calories, higherIsBetter: false },
  { label: 'Protein', unit: 'g', value1: food1.protein, value2: food2.protein, higherIsBetter: true },
  { label: 'Total Fat', unit: 'g', value1: food1.totalFat, value2: food2.totalFat, higherIsBetter: false },
  { label: 'Saturated Fat', unit: 'g', value1: food1.saturatedFat, value2: food2.saturatedFat, higherIsBetter: false },
  { label: 'Carbohydrates', unit: 'g', value1: food1.carbs, value2: food2.carbs, higherIsBetter: false },
  { label: 'Fiber', unit: 'g', value1: food1.fiber, value2: food2.fiber, higherIsBetter: true },
  { label: 'Sugar', unit: 'g', value1: food1.sugar, value2: food2.sugar, higherIsBetter: false },
  { label: 'Sodium', unit: 'mg', value1: food1.sodium, value2: food2.sodium, higherIsBetter: false },
  { label: 'Cholesterol', unit: 'mg', value1: food1.cholesterol, value2: food2.cholesterol, higherIsBetter: false },
];

function getWinner(row: NutrientRow): 'food1' | 'food2' | 'tie' {
  if (row.value1 === row.value2) return 'tie';
  if (row.higherIsBetter) {
    return row.value1 > row.value2 ? 'food1' : 'food2';
  }
  return row.value1 < row.value2 ? 'food1' : 'food2';
}
---

<div class="overflow-hidden rounded-lg border border-border-main bg-white">
  <div class="border-b border-border-main bg-bg-alt px-4 py-3">
    <h2 class="text-lg font-bold text-text-main">Side-by-Side Nutrition Comparison</h2>
    <p class="text-sm text-text-muted">Per 100g serving &mdash; green highlights the better value</p>
  </div>

  <div class="overflow-x-auto">
    <table class="w-full text-sm">
      <thead>
        <tr class="border-b-2 border-border-main bg-bg-alt">
          <th class="px-4 py-3 text-left font-semibold text-text-main">Nutrient</th>
          <th class="px-4 py-3 text-right font-semibold text-text-main">{food1.name}</th>
          <th class="px-4 py-3 text-right font-semibold text-text-main">{food2.name}</th>
        </tr>
      </thead>
      <tbody>
        {rows.map((row, i) => {
          const winner = getWinner(row);
          const isCalories = row.label === 'Calories';
          return (
            <tr class:list={[
              'border-b border-border-main transition-colors',
              i % 2 === 0 ? 'bg-white' : 'bg-bg-alt/50',
            ]}>
              <td class:list={[
                'px-4 py-2.5 font-medium text-text-main',
                isCalories && 'text-base font-bold',
              ]}>
                {row.label}
                <span class="ml-1 text-xs text-text-muted">({row.unit})</span>
              </td>
              <td class:list={[
                'px-4 py-2.5 text-right tabular-nums',
                isCalories && 'text-base font-bold',
                winner === 'food1' ? 'bg-primary-light font-semibold text-primary-dark' : 'text-text-main',
              ]}>
                {row.value1}
              </td>
              <td class:list={[
                'px-4 py-2.5 text-right tabular-nums',
                isCalories && 'text-base font-bold',
                winner === 'food2' ? 'bg-primary-light font-semibold text-primary-dark' : 'text-text-main',
              ]}>
                {row.value2}
              </td>
            </tr>
          );
        })}
      </tbody>
    </table>
  </div>

  <div class="border-t border-border-main px-4 py-2 text-xs text-text-muted">
    All values are per 100 grams. Green-highlighted cells indicate the nutritionally favorable value for each nutrient.
  </div>
</div>
