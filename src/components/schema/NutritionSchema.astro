---
interface Serving {
  size: string;
  calories?: number;
  [key: string]: unknown;
}

interface Food {
  name: string;
  calories: number;
  protein: number;
  totalFat: number;
  carbs: number;
  fiber: number;
  sugar: number;
  sodium: number;
  cholesterol: number;
  servings: Serving[];
}

interface Props {
  food: Food;
}

const { food } = Astro.props;

const schema = {
  "@context": "https://schema.org",
  "@type": "NutritionInformation",
  name: food.name,
  calories: `${food.calories} calories`,
  fatContent: `${food.totalFat} g`,
  proteinContent: `${food.protein} g`,
  carbohydrateContent: `${food.carbs} g`,
  fiberContent: `${food.fiber} g`,
  sugarContent: `${food.sugar} g`,
  sodiumContent: `${food.sodium} mg`,
  cholesterolContent: `${food.cholesterol} mg`,
  servingSize: food.servings?.[0]?.size ?? undefined,
};
---

<script type="application/ld+json" set:html={JSON.stringify(schema)} />
