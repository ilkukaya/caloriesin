---
interface Props {
  label: string;
  href: string;
}

const { label, href } = Astro.props;
---

<a
  href={href}
  class="inline-block rounded-full border border-border-main px-3 py-1 text-sm text-text-main transition-colors hover:border-primary hover:bg-primary-light hover:text-primary"
>
  {label}
</a>
