---
import Pill from './Pill.astro';

const popularFoods = [
  { label: 'Banana', href: '/banana' },
  { label: 'White Rice', href: '/white-rice' },
  { label: 'Chicken Breast', href: '/chicken-breast' },
  { label: 'Egg', href: '/egg' },
  { label: 'Apple', href: '/apple' },
  { label: 'Pizza', href: '/pizza-pepperoni' },
  { label: 'Avocado', href: '/avocado' },
  { label: 'Pasta', href: '/pasta' },
  { label: 'Salmon', href: '/salmon' },
  { label: 'Oatmeal', href: '/oatmeal' },
  { label: 'Sweet Potato', href: '/sweet-potato' },
  { label: 'Greek Yogurt', href: '/greek-yogurt' },
  { label: 'Almonds', href: '/almonds' },
  { label: 'Broccoli', href: '/broccoli' },
  { label: 'Tuna', href: '/tuna' },
  { label: 'Strawberry', href: '/strawberry' },
];
---

<div class="flex flex-wrap gap-2">
  {popularFoods.map((food) => (
    <Pill label={food.label} href={food.href} />
  ))}
</div>
