---
import Badge from '../shared/Badge.astro';
import FoodImage from './FoodImage.astro';

interface Props {
  name: string;
  slug?: string;
  category?: string;
  calories: number;
  servingLabel?: string;
  servingGrams?: number;
  badgeLabel: string;
  badgeColor: string;
}

const { name, slug, category, calories, servingLabel, servingGrams, badgeLabel, badgeColor } = Astro.props;

const servingCalories = servingLabel && servingGrams
  ? Math.round(calories * servingGrams / 100)
  : null;
---

<section class="rounded-2xl bg-white p-8 text-center shadow-sm">
  <h1 class="mb-6 text-3xl font-bold text-text-main md:text-4xl">
    How Many Calories in {name}?
  </h1>

  {slug && (
    <div class="mb-6 flex justify-center">
      <FoodImage slug={slug} name={name} category={category} size="lg" />
    </div>
  )}

  <div class="mb-2">
    <span class="text-6xl font-bold text-primary">{calories}</span>
  </div>
  <p class="mb-4 text-sm font-semibold uppercase tracking-wider text-text-muted">
    Calories per 100g
  </p>

  {servingLabel && servingGrams && servingCalories !== null && (
    <p class="mb-4 text-base text-text-main">
      Serving: {servingLabel} ({servingGrams}g) = <span class="font-semibold text-primary">{servingCalories} cal</span>
    </p>
  )}

  <Badge label={badgeLabel} color={badgeColor} />
</section>
