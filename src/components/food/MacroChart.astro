---
interface Props {
  protein: number;
  carbs: number;
  fat: number;
  fiber?: number;
  sugar?: number;
}

const { protein, carbs, fat, fiber, sugar } = Astro.props;

const proteinCal = protein * 4;
const carbsCal = carbs * 4;
const fatCal = fat * 9;
const totalCal = proteinCal + carbsCal + fatCal;

const carbsPct = totalCal > 0 ? Math.round((carbsCal / totalCal) * 100) : 0;
const proteinPct = totalCal > 0 ? Math.round((proteinCal / totalCal) * 100) : 0;
const fatPct = totalCal > 0 ? 100 - carbsPct - proteinPct : 0;

const carbsEnd = carbsPct;
const proteinEnd = carbsPct + proteinPct;

const gradient = totalCal > 0
  ? `conic-gradient(#FFC107 0% ${carbsEnd}%, #F44336 ${carbsEnd}% ${proteinEnd}%, #FF9800 ${proteinEnd}% 100%)`
  : 'conic-gradient(#E0E0E0 0% 100%)';
---

<div class="rounded-2xl bg-white p-6 shadow-sm">
  <h2 class="mb-4 text-xl font-bold text-text-main">Macronutrient Breakdown</h2>

  <div class="flex flex-col items-center gap-6 sm:flex-row sm:items-start">
    {/* Donut chart */}
    <div class="relative h-48 w-48 shrink-0">
      <div
        class="h-full w-full rounded-full"
        style={`background: ${gradient};`}
      />
      <div class="absolute inset-0 m-auto h-28 w-28 rounded-full bg-white flex items-center justify-center">
        <div class="text-center">
          <span class="block text-2xl font-bold text-text-main">{totalCal}</span>
          <span class="block text-xs text-text-muted">kcal</span>
        </div>
      </div>
    </div>

    {/* Legend */}
    <div class="flex flex-col gap-3">
      <div class="flex items-center gap-2">
        <span class="inline-block h-3 w-3 rounded-full" style="background: #FFC107;" />
        <span class="text-sm text-text-main">
          Carbs: {carbs}g ({carbsPct}%)
        </span>
      </div>
      <div class="flex items-center gap-2">
        <span class="inline-block h-3 w-3 rounded-full" style="background: #F44336;" />
        <span class="text-sm text-text-main">
          Protein: {protein}g ({proteinPct}%)
        </span>
      </div>
      <div class="flex items-center gap-2">
        <span class="inline-block h-3 w-3 rounded-full" style="background: #FF9800;" />
        <span class="text-sm text-text-main">
          Fat: {fat}g ({fatPct}%)
        </span>
      </div>

      {(fiber !== undefined || sugar !== undefined) && (
        <div class="mt-2 border-t border-border-main pt-2 text-sm text-text-muted">
          {fiber !== undefined && <p>Fiber: {fiber}g</p>}
          {sugar !== undefined && <p>Sugar: {sugar}g</p>}
        </div>
      )}
    </div>
  </div>
</div>
