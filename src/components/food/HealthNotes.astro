---
interface Props {
  notes: string[];
}

const { notes } = Astro.props;
---

<div class="rounded-2xl bg-white p-6 shadow-sm">
  <h2 class="mb-4 text-xl font-bold text-text-main">Health Notes</h2>

  <ul class="space-y-3">
    {notes.map((note) => (
      <li class="flex items-start gap-3">
        <svg class="mt-0.5 h-5 w-5 shrink-0 text-primary" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
          <path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd" />
        </svg>
        <span class="text-sm text-text-main">{note}</span>
      </li>
    ))}
  </ul>

  <p class="mt-6 rounded-lg border border-border-main bg-bg-alt p-3 text-xs text-text-muted">
    This information is for general reference only. Consult a healthcare professional for dietary advice.
  </p>
</div>
