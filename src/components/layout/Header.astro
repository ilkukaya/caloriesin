---
const categories = [
  { label: 'Fruits', href: '/category/fruits' },
  { label: 'Vegetables', href: '/category/vegetables' },
  { label: 'Meats', href: '/category/meats' },
  { label: 'Seafood', href: '/category/seafood' },
  { label: 'Dairy', href: '/category/dairy' },
  { label: 'Grains', href: '/category/grains' },
  { label: 'Legumes', href: '/category/legumes' },
  { label: 'Nuts & Seeds', href: '/category/nuts-and-seeds' },
  { label: 'Beverages', href: '/category/beverages' },
  { label: 'Snacks', href: '/category/snacks' },
  { label: 'Condiments', href: '/category/condiments' },
  { label: 'Fast Food', href: '/category/fast-food' },
];

const tools = [
  { label: 'Calorie Calculator', href: '/tools/calorie-calculator' },
  { label: 'BMI Calculator', href: '/tools/bmi-calculator' },
  { label: 'Macro Calculator', href: '/tools/macro-calculator' },
];
---

<header class="sticky top-0 z-50 bg-white border-b border-border-main">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-14 md:h-16">
      <!-- Logo -->
      <a href="/" class="flex items-center gap-1.5 flex-shrink-0">
        <svg class="w-7 h-7 text-primary" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <path d="M16 4c-2 0-4 1.5-4 4 0 1.5.5 2.5 1 3.5-3-1-6 .5-6 3.5 0 2.5 2 4 4 4.5-.5 1-1 2.5-1 4 0 3 2.5 5 6 5s6-2 6-5c0-1.5-.5-3-1-4 2-.5 4-2 4-4.5 0-3-3-4.5-6-3.5.5-1 1-2 1-3.5 0-2.5-2-4-4-4z" fill="currentColor" opacity="0.15"/>
          <path d="M16 3c1-3 5-3 6 0 .5 1.5-.5 3-1.5 3.5 2-.5 4.5.5 4 3-.3 1.5-2 2.5-3.5 2.5 2 1 3 3.5 1.5 5.5-1 1.3-3 1.8-4.5 1 1 2 .5 4.5-1.5 5.5-1.5.8-3.5.3-4.5-1-1 1.3-3 1.8-4.5 1-2-1-2.5-3.5-1.5-5.5-1.5.8-3.5.3-4.5-1-1.5-2-.5-4.5 1.5-5.5-1.5 0-3.2-1-3.5-2.5-.5-2.5 2-3.5 4-3C7 6 6 4.5 6.5 3c1-3 5-3 6 0 .5 1.5 0 3-.5 3.5C13 6 14.5 5.5 16 6c1.5-.5 3-1 4-1-.5-.5-1-2-.5-3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
          <circle cx="16" cy="16" r="3" fill="currentColor"/>
        </svg>
        <span class="text-xl font-bold text-text-main">
          Calories<span class="text-primary">In</span>
        </span>
      </a>

      <!-- Desktop Search -->
      <form action="/search" method="get" class="hidden md:flex items-center flex-1 max-w-md mx-6">
        <div class="relative w-full">
          <input
            type="search"
            name="q"
            placeholder="Search foods..."
            class="w-full pl-10 pr-4 py-2 rounded-lg border border-border-main bg-bg-alt text-sm text-text-main placeholder:text-text-muted focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-colors"
            autocomplete="off"
          />
          <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-text-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
          </svg>
        </div>
      </form>

      <!-- Desktop Navigation -->
      <nav class="hidden md:flex items-center gap-1">
        <!-- Categories Dropdown -->
        <div class="relative" data-dropdown>
          <button
            type="button"
            class="flex items-center gap-1 px-3 py-2 text-sm font-medium text-text-main hover:text-primary rounded-md hover:bg-primary-light transition-colors"
            data-dropdown-toggle
          >
            Categories
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
            </svg>
          </button>
          <div class="absolute top-full left-0 mt-1 w-48 bg-white border border-border-main rounded-lg shadow-lg py-1 hidden" data-dropdown-menu>
            {categories.map((cat) => (
              <a href={cat.href} class="block px-4 py-2 text-sm text-text-main hover:bg-primary-light hover:text-primary transition-colors">
                {cat.label}
              </a>
            ))}
          </div>
        </div>

        <!-- Tools Dropdown -->
        <div class="relative" data-dropdown>
          <button
            type="button"
            class="flex items-center gap-1 px-3 py-2 text-sm font-medium text-text-main hover:text-primary rounded-md hover:bg-primary-light transition-colors"
            data-dropdown-toggle
          >
            Tools
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
            </svg>
          </button>
          <div class="absolute top-full left-0 mt-1 w-52 bg-white border border-border-main rounded-lg shadow-lg py-1 hidden" data-dropdown-menu>
            {tools.map((tool) => (
              <a href={tool.href} class="block px-4 py-2 text-sm text-text-main hover:bg-primary-light hover:text-primary transition-colors">
                {tool.label}
              </a>
            ))}
          </div>
        </div>

        <a href="/blog" class="px-3 py-2 text-sm font-medium text-text-main hover:text-primary rounded-md hover:bg-primary-light transition-colors">Blog</a>
        <a href="/about" class="px-3 py-2 text-sm font-medium text-text-main hover:text-primary rounded-md hover:bg-primary-light transition-colors">About</a>
      </nav>

      <!-- Mobile: Search Toggle + Hamburger -->
      <div class="flex items-center gap-2 md:hidden">
        <button
          type="button"
          id="mobile-search-toggle"
          class="p-2 text-text-muted hover:text-primary rounded-md transition-colors"
          aria-label="Toggle search"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
          </svg>
        </button>
        <button
          type="button"
          id="mobile-menu-toggle"
          class="p-2 text-text-muted hover:text-primary rounded-md transition-colors"
          aria-label="Toggle menu"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" id="hamburger-icon">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
          </svg>
          <svg class="w-5 h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24" id="close-icon">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
          </svg>
        </button>
      </div>
    </div>

    <!-- Mobile Search Bar (hidden by default) -->
    <div id="mobile-search" class="hidden pb-3 md:hidden">
      <form action="/search" method="get">
        <div class="relative">
          <input
            type="search"
            name="q"
            placeholder="Search foods..."
            class="w-full pl-10 pr-4 py-2.5 rounded-lg border border-border-main bg-bg-alt text-sm text-text-main placeholder:text-text-muted focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary"
            autocomplete="off"
          />
          <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-text-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
          </svg>
        </div>
      </form>
    </div>
  </div>

  <!-- Mobile Menu (hidden by default) -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-border-main bg-white">
    <div class="max-w-7xl mx-auto px-4 py-3 space-y-1">
      <!-- Mobile Categories -->
      <div data-mobile-dropdown>
        <button
          type="button"
          class="flex items-center justify-between w-full px-3 py-2.5 text-sm font-medium text-text-main rounded-md hover:bg-primary-light transition-colors"
          data-mobile-dropdown-toggle
        >
          Categories
          <svg class="w-4 h-4 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24" data-mobile-dropdown-arrow>
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
          </svg>
        </button>
        <div class="hidden pl-4 space-y-0.5" data-mobile-dropdown-menu>
          {categories.map((cat) => (
            <a href={cat.href} class="block px-3 py-2 text-sm text-text-muted hover:text-primary transition-colors">
              {cat.label}
            </a>
          ))}
        </div>
      </div>

      <!-- Mobile Tools -->
      <div data-mobile-dropdown>
        <button
          type="button"
          class="flex items-center justify-between w-full px-3 py-2.5 text-sm font-medium text-text-main rounded-md hover:bg-primary-light transition-colors"
          data-mobile-dropdown-toggle
        >
          Tools
          <svg class="w-4 h-4 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24" data-mobile-dropdown-arrow>
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
          </svg>
        </button>
        <div class="hidden pl-4 space-y-0.5" data-mobile-dropdown-menu>
          {tools.map((tool) => (
            <a href={tool.href} class="block px-3 py-2 text-sm text-text-muted hover:text-primary transition-colors">
              {tool.label}
            </a>
          ))}
        </div>
      </div>

      <a href="/blog" class="block px-3 py-2.5 text-sm font-medium text-text-main rounded-md hover:bg-primary-light transition-colors">Blog</a>
      <a href="/about" class="block px-3 py-2.5 text-sm font-medium text-text-main rounded-md hover:bg-primary-light transition-colors">About</a>
    </div>
  </div>
</header>

<script>
  // Mobile menu toggle
  const menuToggle = document.getElementById('mobile-menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');
  const hamburgerIcon = document.getElementById('hamburger-icon');
  const closeIcon = document.getElementById('close-icon');

  menuToggle?.addEventListener('click', () => {
    const isOpen = !mobileMenu?.classList.contains('hidden');
    mobileMenu?.classList.toggle('hidden');
    hamburgerIcon?.classList.toggle('hidden', !isOpen);
    closeIcon?.classList.toggle('hidden', isOpen);
  });

  // Mobile search toggle
  const searchToggle = document.getElementById('mobile-search-toggle');
  const mobileSearch = document.getElementById('mobile-search');

  searchToggle?.addEventListener('click', () => {
    mobileSearch?.classList.toggle('hidden');
    if (!mobileSearch?.classList.contains('hidden')) {
      mobileSearch?.querySelector('input')?.focus();
    }
  });

  // Desktop dropdowns
  document.querySelectorAll('[data-dropdown]').forEach((dropdown) => {
    const toggle = dropdown.querySelector('[data-dropdown-toggle]');
    const menu = dropdown.querySelector('[data-dropdown-menu]');

    toggle?.addEventListener('click', (e) => {
      e.stopPropagation();
      // Close other dropdowns
      document.querySelectorAll('[data-dropdown-menu]').forEach((m) => {
        if (m !== menu) m.classList.add('hidden');
      });
      menu?.classList.toggle('hidden');
    });
  });

  // Mobile dropdowns
  document.querySelectorAll('[data-mobile-dropdown]').forEach((dropdown) => {
    const toggle = dropdown.querySelector('[data-mobile-dropdown-toggle]');
    const menu = dropdown.querySelector('[data-mobile-dropdown-menu]');
    const arrow = dropdown.querySelector('[data-mobile-dropdown-arrow]');

    toggle?.addEventListener('click', () => {
      menu?.classList.toggle('hidden');
      arrow?.classList.toggle('rotate-180');
    });
  });

  // Close desktop dropdowns on outside click
  document.addEventListener('click', () => {
    document.querySelectorAll('[data-dropdown-menu]').forEach((menu) => {
      menu.classList.add('hidden');
    });
  });
</script>
