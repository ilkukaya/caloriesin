---
const popularFoods = [
  { label: 'Banana', href: '/banana' },
  { label: 'Chicken Breast', href: '/chicken-breast' },
  { label: 'Rice', href: '/rice' },
  { label: 'Egg', href: '/egg' },
  { label: 'Apple', href: '/apple' },
];

const categoryLinks = [
  { label: 'Fruits', href: '/category/fruits' },
  { label: 'Vegetables', href: '/category/vegetables' },
  { label: 'Meats', href: '/category/meats' },
  { label: 'Dairy', href: '/category/dairy' },
  { label: 'Fast Food', href: '/category/fast-food' },
];

const toolLinks = [
  { label: 'Calorie Calculator', href: '/tools/calorie-calculator' },
  { label: 'BMI Calculator', href: '/tools/bmi-calculator' },
  { label: 'Macro Calculator', href: '/tools/macro-calculator' },
];

const bottomLinks = [
  { label: 'Blog', href: '/blog' },
  { label: 'About', href: '/about' },
  { label: 'Privacy', href: '/privacy' },
  { label: 'Terms', href: '/terms' },
  { label: 'Contact', href: '/contact' },
];
---

<footer class="bg-gray-900 text-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <!-- Top: Logo + Columns -->
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8 lg:gap-12">
      <!-- Logo & Tagline -->
      <div>
        <a href="/" class="flex items-center gap-1.5 mb-3">
          <svg class="w-6 h-6 text-primary" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path d="M16 4c-2 0-4 1.5-4 4 0 1.5.5 2.5 1 3.5-3-1-6 .5-6 3.5 0 2.5 2 4 4 4.5-.5 1-1 2.5-1 4 0 3 2.5 5 6 5s6-2 6-5c0-1.5-.5-3-1-4 2-.5 4-2 4-4.5 0-3-3-4.5-6-3.5.5-1 1-2 1-3.5 0-2.5-2-4-4-4z" fill="currentColor" opacity="0.3"/>
            <circle cx="16" cy="16" r="3" fill="currentColor"/>
          </svg>
          <span class="text-lg font-bold">
            Calories<span class="text-primary">In</span>
          </span>
        </a>
        <p class="text-sm text-gray-400 leading-relaxed">
          Free Calorie &amp; Nutrition Data
        </p>
      </div>

      <!-- Popular Foods -->
      <div>
        <h3 class="text-sm font-semibold uppercase tracking-wider text-gray-300 mb-4">Popular Foods</h3>
        <ul class="space-y-2.5">
          {popularFoods.map((food) => (
            <li>
              <a href={food.href} class="text-sm text-gray-400 hover:text-white transition-colors">
                {food.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Categories -->
      <div>
        <h3 class="text-sm font-semibold uppercase tracking-wider text-gray-300 mb-4">Categories</h3>
        <ul class="space-y-2.5">
          {categoryLinks.map((cat) => (
            <li>
              <a href={cat.href} class="text-sm text-gray-400 hover:text-white transition-colors">
                {cat.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Tools -->
      <div>
        <h3 class="text-sm font-semibold uppercase tracking-wider text-gray-300 mb-4">Tools</h3>
        <ul class="space-y-2.5">
          {toolLinks.map((tool) => (
            <li>
              <a href={tool.href} class="text-sm text-gray-400 hover:text-white transition-colors">
                {tool.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <!-- Divider -->
    <div class="border-t border-gray-800 mt-10 pt-8">
      <!-- Bottom Links -->
      <div class="flex flex-wrap items-center justify-center gap-x-6 gap-y-2 mb-6">
        {bottomLinks.map((link) => (
          <a href={link.href} class="text-sm text-gray-400 hover:text-white transition-colors">
            {link.label}
          </a>
        ))}
      </div>

      <!-- Affiliate Disclosure -->
      <p class="text-xs text-gray-500 text-center mb-4 max-w-2xl mx-auto leading-relaxed">
        Affiliate Disclosure: Some links on this site may be affiliate links. We may earn a small commission at no extra cost to you if you make a purchase through these links.
      </p>

      <!-- Data Attribution -->
      <p class="text-xs text-gray-500 text-center mb-4">
        Data source: <a href="https://fdc.nal.usda.gov/" class="underline hover:text-gray-300 transition-colors" target="_blank" rel="noopener noreferrer">USDA FoodData Central</a>
      </p>

      <!-- Copyright -->
      <p class="text-xs text-gray-500 text-center">
        &copy; 2026 CaloriesIn. All rights reserved.
      </p>
    </div>
  </div>
</footer>
